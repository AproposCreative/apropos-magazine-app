# Gobio.dk Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# TMDB (The Movie Database)
# Sign up: https://www.themoviedb.org/settings/api
# ============================================================
# v3 API key (32-char hex string) - required
TMDB_API_KEY=your-tmdb-v3-api-key
# v4 Read Access Token (optional, long JWT-like string)
# If provided, Bearer auth is used instead of api_key query param
# TMDB_READ_ACCESS_TOKEN=your-tmdb-read-access-token

# ============================================================
# International Showtimes API
# Sign up: https://www.internationalshowtimes.com/subscription
# ============================================================
SHOWTIMES_API_KEY=your-showtimes-api-key

# ============================================================
# Redis (Upstash)
# Sign up: https://upstash.com
# ============================================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ============================================================
# Email (Resend)
# Sign up: https://resend.com
# ============================================================
RESEND_API_KEY=your-resend-api-key

# ============================================================
# App
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
